# APP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_VERSION=foundation-v0.1
APP_CORS_ORIGINS=http://localhost:3000

# DATABASE
POSTGRES_DB=healthtrack
POSTGRES_USER=healthtrack
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthtrack:local-only-change-me@localhost:5432/healthtrack?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_TTL=30d

# MINIO
MINIO_ROOT_USER=healthtrack-local
MINIO_ROOT_PASSWORD=local-only-change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=healthtrack-private

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# OTP
OTP_PROVIDER=mock
OTP_FROM_EMAIL=
OTP_FROM_PHONE=

# NOTIFICATION
NOTIFICATION_PROVIDER=mock

# PDF
PDF_PROVIDER=mock

