// FOUNDATION SCHEMA — APPROVED FOR INITIAL LOCAL MIGRATION ON 2026-11-19.
// Source: approved Business Analysis v0.2 and Foundation integration contract.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum MedicalDocumentType {
  PRESCRIPTION
  LAB_RESULT
  MEDICAL_VISIT
  MEDICAL_IMAGE
  OTHER
}

enum HealthSex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum DataSource {
  USER_INPUT
  HEALTH_CONNECT
  IMPORTED
  SYSTEM_GENERATED
}

enum ReminderType {
  WATER
  SLEEP
  MEDICATION
  APPOINTMENT
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReminderOccurrenceStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  MISSED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SmartAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  DISMISSED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MoodType {
  HAPPY
  NORMAL
  SAD
  STRESSED
  ANXIOUS
}

enum HealthSyncStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
}

enum ActivityGoalType {
  STEPS
  ACTIVE_MINUTES
  CALORIES_BURNED
  DISTANCE
}

enum ActivityGoalPeriod {
  DAILY
  WEEKLY
}

enum ExerciseRecommendationStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum ReportStatus {
  REQUESTED
  GENERATING
  READY
  FAILED
}

enum ConsentType {
  AI_HEALTH_CONTEXT
  AI_MEDICAL_DOCUMENT
  AI_REPORT_SUMMARY
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  fullName            String                   @db.VarChar(80)
  email               String?                  @unique @db.VarChar(320)
  phone               String?                  @unique @db.VarChar(20)
  status              UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?                @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?                @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?                @db.Timestamptz(6)
  credential          UserCredential?
  refreshTokens       RefreshToken[]
  otpChallenges       OtpChallenge[]
  healthProfile       HealthProfile?
  medicalDocuments    MedicalDocument[]
  bodyMetrics         BodyMetric[]
  vitalSigns          VitalSign[]
  reminders           Reminder[]
  reminderEvents      ReminderOccurrence[]
  medicationPlans     MedicationSchedule[]
  appointments        Appointment[]
  smartAlerts         SmartAlert[]
  foodEntries         FoodEntry[]
  moodEntries         MoodEntry[]
  syncRecords         HealthSyncRecord[]
  waterIntakeLogs     WaterIntakeLog[]
  activityGoals       ActivityGoal[]
  workoutSessions     WorkoutSession[]
  exerciseSuggestions ExerciseRecommendation[]
  aiConversations     AIConversation[]
  reports             Report[]
  consents            UserConsent[]
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model UserCredential {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @db.Uuid
  passwordHash        String    @db.VarChar(255)
  passwordChangedAt   DateTime  @default(now()) @db.Timestamptz(6)
  failedLoginCount    Int       @default(0)
  failedLoginWindowAt DateTime? @db.Timestamptz(6)
  lockedUntil         DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model RefreshToken {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  tokenHash     String        @unique @db.VarChar(255)
  familyId      String        @db.Uuid
  parentTokenId String?       @unique @db.Uuid
  expiresAt     DateTime      @db.Timestamptz(6)
  revokedAt     DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentToken   RefreshToken? @relation("RefreshTokenRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  rotatedToken  RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  channel        OtpChannel
  purpose        OtpPurpose
  codeHash       String     @db.VarChar(255)
  failedAttempts Int        @default(0)
  resendCount    Int        @default(0)
  expiresAt      DateTime   @db.Timestamptz(6)
  consumedAt     DateTime?  @db.Timestamptz(6)
  invalidatedAt  DateTime?  @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model HealthProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  birthDate          DateTime? @db.Date
  sex                HealthSex @default(UNSPECIFIED)
  bloodType          String?   @db.VarChar(5)
  allergies          String[]  @default([])
  medicalHistory     String[]  @default([])
  currentMedications String[]  @default([])
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model MedicalDocument {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  title        String              @db.VarChar(150)
  type         MedicalDocumentType
  documentDate DateTime?           @db.Date
  originalName String              @db.VarChar(255)
  contentType  String              @db.VarChar(100)
  sizeBytes    BigInt
  storageKey   String              @unique @db.VarChar(512)
  description  String?             @db.Text
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?           @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentDate])
  @@map("medical_documents")
}

model BodyMetric {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  heightCm       Decimal?   @db.Decimal(7, 2)
  weightKg       Decimal?   @db.Decimal(7, 2)
  bmi            Decimal?   @db.Decimal(6, 2)
  measuredAt     DateTime   @db.Timestamptz(6)
  sourceType     DataSource
  sourceApp      String?    @db.VarChar(255)
  sourceDevice   String?    @db.VarChar(255)
  sourceRecordId String?    @db.VarChar(255)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceRecordId])
  @@index([userId, measuredAt])
  @@map("body_metrics")
}

model VitalSign {
  id                      String     @id @default(uuid()) @db.Uuid
  userId                  String     @db.Uuid
  heartRateBpm            Int?
  systolicMmHg            Int?
  diastolicMmHg           Int?
  bodyTemperatureCelsius  Decimal?   @db.Decimal(5, 2)
  oxygenSaturationPercent Decimal?   @db.Decimal(5, 2)
  respiratoryRatePerMin   Decimal?   @db.Decimal(5, 2)
  measuredAt              DateTime   @db.Timestamptz(6)
  sourceType              DataSource
  sourceApp               String?    @db.VarChar(255)
  sourceDevice            String?    @db.VarChar(255)
  sourceRecordId          String?    @db.VarChar(255)
  createdAt               DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @db.Timestamptz(6)
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceRecordId])
  @@index([userId, measuredAt])
  @@map("vital_signs")
}

model Reminder {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  type           ReminderType
  title          String               @db.VarChar(120)
  notes          String?              @db.Text
  timezone       String               @db.VarChar(100)
  schedule       Json
  targetAmountMl Int?
  status         ReminderStatus       @default(ACTIVE)
  startDate      DateTime?            @db.Date
  endDate        DateTime?            @db.Date
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication     MedicationSchedule?
  appointment    Appointment?
  occurrences    ReminderOccurrence[]

  @@index([userId, type, status])
  @@map("reminders")
}

model ReminderOccurrence {
  id          String                   @id @default(uuid()) @db.Uuid
  userId      String                   @db.Uuid
  reminderId  String                   @db.Uuid
  scheduledAt DateTime                 @db.Timestamptz(6)
  status      ReminderOccurrenceStatus @default(SCHEDULED)
  completedAt DateTime?                @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder    Reminder                 @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledAt])
  @@index([userId, scheduledAt])
  @@map("reminder_occurrences")
}

model MedicationSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  reminderId     String   @unique @db.Uuid
  medicationName String   @db.VarChar(150)
  dosage         String?  @db.VarChar(120)
  instructions   String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder       Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("medication_schedules")
}

model Appointment {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  reminderId         String   @unique @db.Uuid
  title              String   @db.VarChar(150)
  healthcareProvider String?  @db.VarChar(150)
  location           String?  @db.VarChar(255)
  scheduledAt        DateTime @db.Timestamptz(6)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder           Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@map("appointments")
}

model WaterIntakeLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  amountMl   Int
  consumedAt DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("water_intake_logs")
}

model SmartAlert {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  alertType   String           @db.VarChar(80)
  severity    AlertSeverity
  title       String           @db.VarChar(150)
  message     String           @db.Text
  ruleVersion String           @db.VarChar(50)
  evidence    Json?
  status      SmartAlertStatus @default(ACTIVE)
  triggeredAt DateTime         @db.Timestamptz(6)
  resolvedAt  DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, triggeredAt])
  @@map("smart_alerts")
}

model FoodEntry {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  foodName     String   @db.VarChar(150)
  portion      Decimal  @db.Decimal(10, 2)
  portionUnit  String   @db.VarChar(40)
  caloriesKcal Decimal  @db.Decimal(10, 2)
  mealType     MealType
  consumedAt   DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("food_entries")
}

model MoodEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  mood       MoodType
  note       String?  @db.Text
  recordedAt DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("mood_entries")
}

model HealthSyncRecord {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  clientSyncId       String           @db.VarChar(255)
  sourceType         DataSource       @default(HEALTH_CONNECT)
  dataType           String           @db.VarChar(100)
  sourceRecordId     String           @db.VarChar(255)
  sourceApp          String?          @db.VarChar(255)
  sourceDevice       String?          @db.VarChar(255)
  eventTime          DateTime         @db.Timestamptz(6)
  payloadHash        String           @db.VarChar(128)
  status             HealthSyncStatus @default(RECEIVED)
  targetResourceType String?          @db.VarChar(100)
  targetResourceId   String?          @db.Uuid
  errorCode          String?          @db.VarChar(100)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  processedAt        DateTime?        @db.Timestamptz(6)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientSyncId])
  @@unique([userId, sourceType, sourceRecordId])
  @@index([userId, createdAt])
  @@map("health_sync_records")
}

model ActivityGoal {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @db.Uuid
  type            ActivityGoalType
  targetValue     Decimal                  @db.Decimal(12, 2)
  unit            String                   @db.VarChar(40)
  period          ActivityGoalPeriod
  startDate       DateTime                 @db.Date
  endDate         DateTime?                @db.Date
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations ExerciseRecommendation[]

  @@index([userId, type, active])
  @@map("activity_goals")
}

model WorkoutSession {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @db.Uuid
  activityType       String     @db.VarChar(100)
  startedAt          DateTime   @db.Timestamptz(6)
  endedAt            DateTime?  @db.Timestamptz(6)
  durationSeconds    Int?
  distanceMeters     Decimal?   @db.Decimal(12, 2)
  caloriesBurnedKcal Decimal?   @db.Decimal(12, 2)
  steps              Int?
  sourceType         DataSource
  sourceApp          String?    @db.VarChar(255)
  sourceDevice       String?    @db.VarChar(255)
  sourceRecordId     String?    @db.VarChar(255)
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceRecordId])
  @@index([userId, startedAt])
  @@map("workout_sessions")
}

model ExerciseRecommendation {
  id             String                       @id @default(uuid()) @db.Uuid
  userId         String                       @db.Uuid
  activityGoalId String?                      @db.Uuid
  title          String                       @db.VarChar(150)
  description    String                       @db.Text
  rationale      String?                      @db.Text
  status         ExerciseRecommendationStatus @default(SUGGESTED)
  generatedAt    DateTime                     @db.Timestamptz(6)
  expiresAt      DateTime?                    @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(6)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityGoal   ActivityGoal?                @relation(fields: [activityGoalId], references: [id], onDelete: SetNull)

  @@index([userId, generatedAt])
  @@map("exercise_recommendations")
}

model AIConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  title     String?     @db.VarChar(150)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?   @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id                String         @id @default(uuid()) @db.Uuid
  conversationId    String         @db.Uuid
  role              AIMessageRole
  content           String         @db.Text
  contextCategories String[]       @default([])
  providerMessageId String?        @db.VarChar(255)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  conversation      AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model Report {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  periodFrom        DateTime     @db.Timestamptz(6)
  periodTo          DateTime     @db.Timestamptz(6)
  selectedSections  String[]     @default([])
  status            ReportStatus @default(REQUESTED)
  storageKey        String?      @unique @db.VarChar(512)
  aiSummaryIncluded Boolean      @default(false)
  errorCode         String?      @db.VarChar(100)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  generatedAt       DateTime?    @db.Timestamptz(6)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reports")
}

model UserConsent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      ConsentType
  status    ConsentStatus
  version   String        @db.VarChar(50)
  grantedAt DateTime?     @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_consents")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(100)
  resourceId   String?  @db.Uuid
  traceId      String   @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([traceId])
  @@map("audit_logs")
}
