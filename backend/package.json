{
  "name": "@healthtrack-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HealthTrack AI Backend Foundation",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:auth:integration": "npm run build && node --test test/auth.postgres.integration.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "openapi:generate": "npm run build && node scripts/generate-openapi.mjs",
    "openapi:check": "npm run build && node scripts/generate-openapi.mjs --check",
    "integration:verify": "npm run build && node scripts/verify-integration.mjs",
    "storage:verify": "npm run build && node scripts/verify-storage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "jest": "29.7.0",
    "prisma": "7.10.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
