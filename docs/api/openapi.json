  "info": {
    "title": "HealthTrack AI API",
    "description": "Foundation health and Backend Phase 1 Auth/Users. CCR-002 integration candidate; Android review pending.",
    "version": "foundation-v0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected"
            ],
            "example": "connected"
          },
          "version": {
            "type": "string",
            "example": "foundation-v0.1"
          }
        },
        "required": [
          "status",
          "database",
          "version"
        ]
      },
      "HealthSuccessEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DATABASE_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "example": "Database connectivity check failed."
          },
          "details": {
            "type": "object",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "example": "request-correlation-id"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "traceId"
        ]
      },
      "ApiErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "description": "Exactly one of email or phone. Trimmed and lowercased by Backend."
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "description": "Vietnam phone: ten digits starting with 0. Exactly one identity."
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 128
          },
          "fullName": {
            "type": "string",
            "maxLength": 160,
            "description": "2–80 Unicode code points after trimming."
          },
          "confirmPassword": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 128
          }
        },
        "required": [
          "password",
          "fullName",
          "confirmPassword"
        ]
      },
      "ChallengeResponseDto": {
        "type": "object",
        "properties": {
