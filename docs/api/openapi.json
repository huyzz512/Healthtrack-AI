{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Application and database are available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSuccessEnvelopeDto"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Check application and database health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "HealthTrack AI API",
    "description": "Foundation contract surface; business endpoints are not implemented.",
    "version": "foundation-v0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected"
            ],
            "example": "connected"
          },
          "version": {
            "type": "string",
            "example": "foundation-v0.1"
          }
        },
        "required": [
          "status",
          "database",
          "version"
        ]
      },
      "HealthSuccessEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DATABASE_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "example": "Database connectivity check failed."
          },
          "details": {
            "type": "object",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "example": "request-correlation-id"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "traceId"
        ]
      },
      "ApiErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
